# Keep line endings byte-exact on every platform. Git for Windows converts text files to CRLF
# on checkout by default; the replay fixtures are cut at recorded byte offsets, and the
# committed simulation outputs are compared byte for byte.
* text=auto eol=lf
*.jsonl -text
*.out -text
# lab/ctxeval holds experiment records copied as they were from a Windows PC (some outputs have CRLF):
# store and check them out byte for byte.
lab/ctxeval/** -text
